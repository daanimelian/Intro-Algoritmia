<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="melia"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2024-07-21 10:03:51 p.&#160;m."/>
        <attribute name="created" value="bWVsaWE7TEEtTUVDSElUQS1QQzsyMDI0LTA3LTIxOzA1OjUzOjEzIHAuwqBtLjszMDAw"/>
        <attribute name="edited" value="bWVsaWE7TEEtTUVDSElUQS1QQzsyMDI0LTA3LTIxOzEwOjAzOjUxIHAuwqBtLjsxOzMxMDE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="listaSecuencia" type="Integer" array="True" size="1-2"/>
            <call expression="generarListaSecuencia"/>
            <assign variable="listaSecuencia" expression="generarListaSecuencia"/>
            <declare name="elementoMaximoLista" type="Integer" array="True" size="1-2"/>
            <declare name="elementoMaximo" type="Integer" array="False" size=""/>
            <declare name="elementoMaximoPosicion" type="Integer" array="False" size=""/>
            <call expression="encontrarMaximo(listaSecuencia)"/>
            <assign variable="elementoMaximoLista" expression="encontrarMaximo(listaSecuencia)"/>
            <assign variable="elementoMaximo" expression="elementoMaximoLista(0)"/>
            <assign variable="elementoMaximoPosicion" expression="elementoMaximoLista(1)"/>
            <declare name="elementoMinimoLista" type="Integer" array="True" size="1-2"/>
            <declare name="elementoMinimo" type="Integer" array="False" size=""/>
            <declare name="elementoMinimoPosicion" type="Integer" array="False" size=""/>
            <call expression="encontrarMinimo(listaSecuencia)"/>
            <assign variable="elementoMinimoLista" expression="encontrarMinimo(listaSecuencia)"/>
            <assign variable="elementoMinimo" expression="elementoMinimoLista(0)"/>
            <assign variable="elementoMinimoPosicion" expression="elementoMinimoLista(1)"/>
            <output expression="&quot;El elemento maximo es: &quot;" newline="True"/>
            <output expression="elementoMaximo" newline="True"/>
            <output expression="&quot;y su posicion es : &quot;" newline="True"/>
            <output expression="elementoMaximoPosicion" newline="True"/>
            <output expression="&quot;El elemento minimo es: &quot;" newline="True"/>
            <output expression="elementoMinimo" newline="True"/>
            <output expression="&quot;y su posicion es : &quot;" newline="True"/>
            <output expression="elementoMinimoPosicion" newline="True"/>
            <declare name="listaSecuenciaOrdenada" type="Integer" array="True" size="1-2"/>
            <call expression="ordenarLista(listaSecuencia)"/>
            <assign variable="listaSecuenciaOrdenada" expression="ordenarLista(listaSecuencia)"/>
            <declare name="elementoMaximoPosicion" type="Integer" array="False" size=""/>
            <call expression="busquedaBinaria(listaSecuenciaOrdenada, elementoMaximo)"/>
            <assign variable="elementoMaximoPosicion" expression="busquedaBinaria(listaSecuenciaOrdenada, elementoMaximo)"/>
            <declare name="elementoMinimoPosicion" type="Integer" array="False" size=""/>
            <call expression="busquedaBinaria(listaSecuenciaOrdenada, elementoMinimo)"/>
            <assign variable="elementoMinimoPosicion" expression="busquedaBinaria(listaSecuenciaOrdenada, elementoMinimo)"/>
            <output expression="&quot;La posicion del elemento maximo en la lista ordenada es : &quot;" newline="True"/>
            <output expression="elementoMaximoPosicion" newline="True"/>
            <output expression="&quot;La posicion del elemento minimo en la lista ordenada es : &quot;" newline="True"/>
            <output expression="elementoMinimoPosicion" newline="True"/>
        </body>
    </function>
    <function name="busquedaBinaria" type="Integer" variable="posicion">
        <parameters>
            <parameter name="lista" type="Integer" array="True"/>
            <parameter name="elemento" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="posicion" type="Integer" array="False" size=""/>
            <declare name="izquierda" type="Integer" array="False" size=""/>
            <declare name="derecha" type="Integer" array="False" size=""/>
            <assign variable="izquierda" expression="0"/>
            <assign variable="derecha" expression="largo(lista) - 1"/>
            <while expression="derecha&gt;=izquierda &amp; posicion = -1">
                <declare name="centro" type="Integer" array="False" size=""/>
                <assign variable="centro" expression="(izquierda+derecha)//2"/>
                <if expression="lista[centro] = elemento">
                    <then>
                        <assign variable="posicion" expression="centro"/>
                    </then>
                    <else>
                        <if expression="lista[centro] &gt; elemento">
                            <then>
                                <assign variable="derecha" expression="centro-1"/>
                            </then>
                            <else>
                                <assign variable="izquierda" expression="centro+1"/>
                            </else>
                        </if>
                    </else>
                </if>
            </while>
        </body>
    </function>
    <function name="encontrarMaximo" type="Boolean" variable="elementoMaximoYPosicion">
        <parameters>
            <parameter name="lista" type="Integer" array="True"/>
        </parameters>
        <body>
            <declare name="elementoMaximoYPosicion" type="Boolean" array="False" size=""/>
            <declare name="elementoMaximo" type="Integer" array="False" size=""/>
            <declare name="posicion" type="Integer" array="False" size=""/>
            <assign variable="elementoMaximo" expression="lista[0]"/>
            <assign variable="posicion" expression="0"/>
            <for variable="i" start="1" end="largo(lista)" direction="inc" step="1">
                <if expression="lista[i] &gt; elementoMaximo">
                    <then>
                        <assign variable="elementoMaximo" expression="lista[i]"/>
                        <assign variable="posicion" expression="i"/>
                    </then>
                    <else/>
                </if>
            </for>
            <assign variable="elementoMaximoYPosicion" expression="(elementoMaximo, posicion)"/>
        </body>
    </function>
    <function name="encontrarMinimo" type="Integer" variable="elementoMinimoYPosicion">
        <parameters>
            <parameter name="lista" type="Integer" array="True"/>
        </parameters>
        <body>
            <declare name="elementoMinimoYPosicion" type="Integer" array="False" size=""/>
            <declare name="elementoMinimo" type="Integer" array="False" size=""/>
            <declare name="posicion" type="Integer" array="False" size=""/>
            <assign variable="elementoMinimo" expression="lista[0]"/>
            <assign variable="posicion" expression="0"/>
            <for variable="i" start="1" end="largo(lista)" direction="inc" step="1">
                <if expression="lista[i] &lt; elementoMinimo">
                    <then>
                        <assign variable="elementoMinimo" expression="lista[i]"/>
                        <assign variable="posicion" expression="i"/>
                    </then>
                    <else/>
                </if>
            </for>
            <assign variable="elementoMinimoYPosicion" expression="(elementoMinimo, posicion)"/>
        </body>
    </function>
    <function name="generarListaSecuencia" type="String" variable="secuencias">
        <parameters>
            <parameter name="largo" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="secuencias" type="String" array="False" size=""/>
            <for variable="i" start="0" end="largo" direction="inc" step="1">
                <declare name="numRandom" type="Integer" array="False" size=""/>
                <assign variable="numRandom" expression="generarEnteroRandom(1,20)"/>
                <assign variable="secuencia" expression="secuencia.append(numRandom)"/>
            </for>
        </body>
    </function>
    <function name="ordenarLista" type="Integer" variable="listaOrdenada">
        <parameters>
            <parameter name="lista" type="Integer" array="True"/>
        </parameters>
        <body>
            <declare name="listaOrdenada" type="Integer" array="False" size=""/>
            <declare name="largoLista" type="Integer" array="False" size=""/>
            <assign variable="largoLista" expression="largo(lista)"/>
            <for variable="i" start="0" end="largo-1" direction="inc" step="1">
                <for variable="j" start="i+1" end="largo" direction="inc" step="1">
                    <if expression="lista[i] &gt; lista[j]">
                        <then>
                            <declare name="auxiliar" type="Integer" array="False" size=""/>
                            <assign variable="auxiliar" expression="lista[i]"/>
                            <assign variable="lista[i]" expression="lista[j]"/>
                            <assign variable="lista[j]" expression="auxiliar"/>
                        </then>
                        <else/>
                    </if>
                </for>
            </for>
        </body>
    </function>
</flowgorithm>
